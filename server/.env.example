# Server runtime
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://dial:dial@localhost:5432/dial"

# Password for the seed script's default admin account (npm run db:seed
# with no --password flag). Required — the script refuses to run without it.
SEED_ADMIN_PASSWORD=

# OpenAI-compatible API
OPENAI_BASE_URL='https://api.openai.com/v1'
OPENAI_API_KEY=
MODEL='gpt-5.6'