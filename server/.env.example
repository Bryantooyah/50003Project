# Server runtime
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://dial:dial@localhost:5432/dial"
# Set to "true" only when DATABASE_URL points at a hosted Postgres that
# requires SSL (Render/Neon/Railway/Supabase external URLs). Leave unset
# for local Docker Postgres.
DATABASE_SSL=

# Allowed frontend origin for CORS. Leave unset for local dev
# (defaults to http://localhost:5173). Set to the deployed frontend URL
# in production (see README "Deploying").
CORS_ORIGIN=

# Password for the seed script's default admin account (npm run db:seed
# with no --password flag). Required — the script refuses to run without it.
SEED_ADMIN_PASSWORD=

# OpenAI-compatible API
OPENAI_BASE_URL='https://api.openai.com/v1'
OPENAI_API_KEY=
MODEL='gpt-5.6'